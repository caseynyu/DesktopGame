  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: The Earth teaches us that all things come as they go, and change as they
    proceed. The sun has set into the deep abyss of a nuclear night. Join us as we
    leap forward, forward to the place of our birth, forward to the Marsupial Dawn.
  m_isRightToLeft: 0
