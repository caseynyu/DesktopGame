--- !u!114 &5815152856984172698
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 592486958216837690}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Picture this: a winter evening at home, kids playing in the playroom,
    you wife at the stove, making dinner. And you, sitting down, kicking up your
    feet after a long day of work. Sitting, comfortably, except...

    Oh no! It
    couldn''t be! Is your head cold? Is your pathetic bald head cold? Is it because
    you refused to buy a hat because you said that you didn''t need one? Even though
    your wife said you needed one? And then, for two years, you made it your whole
    personality to not wear hats, even in the winter, so much so that the office
    gave you a shirt that said "I''m bald and I like everyone to know"? And then
    one day, you left a hand-knitted hat in the wrong dresser drawer, and your wife
    found it, because she folded your laundry, just like she washed your dishes and
    took out your trash and looked after your kids for thirteen long years? And she
    realized? And she realized that you''d been going behind her back for seven whole
    months with a cute redhead named Charlotte who likes knitting and makes a wonderful
    butternut squash cassarole and is more of a woman than I''ll ever be? Is that
    it? Is that why your head''s cold, Karl?!??!'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 96307f6c2bc25ae40aa22051aa1d2e6b, type: 2}
  m_sharedMaterial: {fileID: -479999285064839197, guid: 96307f6c2bc25ae40aa22051aa1d2e6b, type: 2}
