--- !u!114 &7063624849794940585
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6821381671391748898}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\tThe Seahawks scored a brutal 27 - 6 victory over the Cardinals this
    Sunday, marking their third win of the season. \n\tA rough year so far, this
    victory has pushed the Seahawks to a record of 3 - 6, far worse than their even
    4 - 4 record at this same time last season. \n\tIn their home state of Arizona
    at the Sun Devil Stadium, the Cardinals scored only three points per quarter
    in front of a crowd of almost 30,000 fans, a demoralizing and crushing defeat
    for the team. \n\tShaun Alexander shone as the star of Sunday's victory, securing
    his notoriety as a champion of the team this season. On a play in the early second
    quarter, Matt Hasselback completed a pass to Alexander for a gain of 37 yards,
    taking the Seahawks out of Cardinal territory and up to the 42-yard line. From
    there, the offense managed a blitz for Alexander, and the running back took advantage
    of a hole in the Cardinals defense to run the ball into the end zone. Rian Lindell
    then completed an extra point to secure the Seahawks' lead, a position the Cardinals
    never recovered from. \n\tWith this victory under their belts, the Seahawks'
    next game will surely not be one to miss\u2014they'll be playing at home this
    Sunday, the 17th, against the Denver Broncos right here at our own Seahawks Stadium.
    Go Seahawks!\n\n\xA9Seattle Times, 2002\nAuthor James McElroy\nContributing Editor
    Nox Mistry"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0445602e006599347a14a022e954282d, type: 2}
  m_sharedMaterial: {fileID: -3527436854880083569, guid: 0445602e006599347a14a022e954282d, type: 2}
