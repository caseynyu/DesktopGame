  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\tSecretary of the Navy R. Funderburg\u2019s body was recovered from an
    inlet of Puget Sound early this morning after being spotted by local ferry passengers.
    His personal vehicle was found unlocked and with significant signs of struggle,
    leading to suspicions of murder. No official details have been released regarding
    the cause of his death."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0445602e006599347a14a022e954282d, type: 2}
